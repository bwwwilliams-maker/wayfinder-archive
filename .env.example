# Wayfinder Archive — Environment Configuration
# Copy this file to .env for local development.
# Do NOT commit your real .env file to GitHub.

# Port for the local server (Render sets PORT automatically in production)
PORT=3000

# Recommended: Google Gemini API key (enables live Google Search–grounded lookups)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback: OpenAI API key (used only if GEMINI_API_KEY is not set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
